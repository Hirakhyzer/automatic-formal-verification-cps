{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hirakhyzer/automatic-formal-verification-cps/schemas/verification-evidence.schema.json",
  "title": "CPS Verification Evidence Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp_utc",
    "domain",
    "model",
    "property",
    "method",
    "horizon",
    "assumptions",
    "uncertainty",
    "result",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["name", "representation", "parameter_source", "notes"],
      "properties": {
        "name": {"type": "string"},
        "representation": {"type": "string"},
        "parameter_source": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "property": {
      "type": "object",
      "required": ["name", "unsafe_set", "semantics"],
      "properties": {
        "name": {"type": "string"},
        "unsafe_set": {"type": "string"},
        "semantics": {"type": "string"}
      },
      "additionalProperties": true
    },
    "method": {
      "type": "object",
      "required": ["name", "configuration", "soundness_boundary"],
      "properties": {
        "name": {"type": "string"},
        "configuration": {"type": "object"},
        "soundness_boundary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "horizon": {
      "type": "object",
      "required": ["steps", "time"],
      "properties": {
        "steps": {"type": "integer", "minimum": 1},
        "time": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "status": {"enum": ["explicit", "validated", "unvalidated", "violated"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["initial_set", "input_bounds", "disturbance_bounds", "cyber_effect_bounds"],
      "properties": {
        "initial_set": {"type": "string"},
        "input_bounds": {"type": "string"},
        "disturbance_bounds": {"type": "string"},
        "cyber_effect_bounds": {"type": "string"}
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["status", "complete", "reason", "notes"],
      "properties": {
        "status": {"enum": ["VERIFIED_SAFE", "POTENTIALLY_UNSAFE", "UNKNOWN"]},
        "complete": {"type": "boolean"},
        "first_intersection_step": {"type": ["integer", "null"], "minimum": 0},
        "first_intersection_time": {"type": ["number", "null"], "minimum": 0},
        "candidate_witness_region": {"type": ["object", "null"]},
        "reason": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["python_version", "platform", "configuration_path", "verification_request"],
      "properties": {
        "python_version": {"type": "string"},
        "platform": {"type": "string"},
        "configuration_path": {"type": ["string", "null"]},
        "verification_request": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
