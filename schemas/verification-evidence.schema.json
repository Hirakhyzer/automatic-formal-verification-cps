{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hirakhyzer/automatic-formal-verification-cps/schemas/verification-evidence.schema.json",
  "title": "CPS Verification Evidence Manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "evidence_fingerprint_sha256", "timestamp_utc", "domain", "model", "property", "method", "horizon", "assumptions", "uncertainty", "result", "reproducibility"],
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "upper": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "verificationRequest": {
      "type": "object",
      "required": ["domain", "method", "steps", "attack_scale", "property_index", "max_generators"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "method": {"enum": ["interval", "zonotope"]},
        "steps": {"type": ["integer", "null"], "minimum": 1},
        "attack_scale": {"type": "number", "minimum": 0},
        "property_index": {"type": "integer", "minimum": 0},
        "max_generators": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "evidence_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["name", "representation", "parameter_source", "notes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "parameter_source": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": ["name", "unsafe_set", "semantics"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unsafe_set": {"type": "string", "minLength": 1},
        "semantics": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name", "configuration", "soundness_boundary"],
      "properties": {
        "name": {"enum": ["interval", "zonotope"]},
        "configuration": {
          "type": "object",
          "required": ["steps", "attack_scale", "property_index"],
          "properties": {
            "steps": {"type": "integer", "minimum": 1},
            "attack_scale": {"type": "number", "minimum": 0},
            "property_index": {"type": "integer", "minimum": 0},
            "max_generators": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "soundness_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "horizon": {
      "type": "object",
      "required": ["steps", "time"],
      "properties": {"steps": {"type": "integer", "minimum": 1}, "time": {"type": "number", "exclusiveMinimum": 0}},
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["explicit", "validated", "unvalidated", "violated"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "required": ["initial_set", "input_bounds", "disturbance_bounds", "cyber_effect_bounds"],
      "properties": {
        "initial_set": {"type": "string", "minLength": 1},
        "input_bounds": {"type": "string", "minLength": 1},
        "disturbance_bounds": {"type": "string", "minLength": 1},
        "cyber_effect_bounds": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status", "complete", "first_intersection_step", "first_intersection_time", "candidate_witness_region", "intersection_diagnostic", "reason", "notes"],
      "properties": {
        "status": {"enum": ["VERIFIED_SAFE", "POTENTIALLY_UNSAFE", "UNKNOWN"]},
        "complete": {"type": "boolean"},
        "first_intersection_step": {"type": ["integer", "null"], "minimum": 0},
        "first_intersection_time": {"type": ["number", "null"], "minimum": 0},
        "candidate_witness_region": {"oneOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "intersection_diagnostic": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["dimension", "overlap_widths", "overlap_volume", "reachable_volume", "unsafe_volume", "reachable_overlap_fraction", "unsafe_overlap_fraction", "candidate_center", "point_intersection"],
              "properties": {
                "dimension": {"type": "integer", "minimum": 1},
                "overlap_widths": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
                "overlap_volume": {"type": "number", "minimum": 0},
                "reachable_volume": {"type": "number", "minimum": 0},
                "unsafe_volume": {"type": "number", "minimum": 0},
                "reachable_overlap_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "unsafe_overlap_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "candidate_center": {"type": "array", "minItems": 1, "items": {"type": "number"}},
                "point_intersection": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "required": ["python_version", "platform", "configuration_path", "verification_request"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "configuration_path": {"type": ["string", "null"]},
        "verification_request": {"$ref": "#/$defs/verificationRequest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
