{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hirakhyzer/automatic-formal-verification-cps/schemas/verification-evidence.schema.json",
  "title": "CPS Verification Evidence Manifest",
  "type": "object",
  "required": [
    "run_id",
    "timestamp_utc",
    "domain",
    "model",
    "property",
    "method",
    "horizon",
    "assumptions",
    "result"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": ["string", "null"]},
    "domain": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["name", "representation"],
      "properties": {
        "name": {"type": "string"},
        "representation": {"type": "string"},
        "parameter_source": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "property": {
      "type": "object",
      "required": ["name", "unsafe_set"],
      "properties": {
        "name": {"type": "string"},
        "unsafe_set": {"type": "string"},
        "semantics": {"type": "string"}
      },
      "additionalProperties": true
    },
    "method": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "configuration": {"type": "object"},
        "soundness_boundary": {"type": "string"}
      },
      "additionalProperties": true
    },
    "horizon": {"type": "integer", "minimum": 1},
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "status"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "status": {"enum": ["explicit", "validated", "unvalidated", "violated"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "initial_set": {"type": "string"},
        "input_bounds": {"type": "string"},
        "disturbance_bounds": {"type": "string"},
        "cyber_effect_bounds": {"type": "string"}
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["status", "complete"],
      "properties": {
        "status": {"enum": ["VERIFIED_SAFE", "POTENTIALLY_UNSAFE", "UNKNOWN"]},
        "complete": {"type": "boolean"},
        "first_intersection_step": {"type": ["integer", "null"], "minimum": 0},
        "candidate_witness_region": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "python_version": {"type": "string"},
        "platform": {"type": "string"},
        "random_seed": {"type": ["integer", "null"]},
        "config_path": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
